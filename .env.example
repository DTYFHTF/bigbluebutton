# ---- Choose a provider -------------------------------------------------------
# anthropic (default) | ollama (local, free) | nvidia | openrouter | groq | custom
HUMANLY_PROVIDER=anthropic

# Anthropic (paid, best quality): https://console.anthropic.com
ANTHROPIC_API_KEY=

# Local and free (no key): install Ollama (ollama.com), run `ollama pull llama3.1:8b`,
# then set HUMANLY_PROVIDER=ollama. The app must run on the same machine as Ollama
# (or set HUMANLY_BASE_URL to where Ollama listens).

# Free hosted options (OpenAI-compatible). Set HUMANLY_PROVIDER to match.
#   nvidia:      key from https://build.nvidia.com  (starts with nvapi-)
#   openrouter:  key from https://openrouter.ai/keys
#   groq:        key from https://console.groq.com/keys
# NVIDIA_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# custom provider: HUMANLY_BASE_URL=https://.../v1 and HUMANLY_API_KEY=

# ---- Models ------------------------------------------------------------------
# Defaults: claude-haiku-5-5 on Anthropic; llama3.1:8b on Ollama; meta/llama-3.3-70b-instruct on NVIDIA;
# meta-llama/llama-3.3-70b-instruct:free on OpenRouter; llama-3.3-70b-versatile
# on Groq. Free catalogues change, so override if a default is retired.
# HUMANLY_FAST_MODEL=
# HUMANLY_BEST_MODEL=
# HUMANLY_JUDGE_MODEL=
# HUMANLY_FAST_EFFORT=low      # Anthropic only
# HUMANLY_BEST_EFFORT=medium   # Anthropic only
# HUMANLY_JUDGE_EFFORT=medium  # Anthropic only

# ---- Judge (scores drafts and evals) -------------------------------------------
# A small model grading its own writing gives optimistic, noisy scores. Point the
# judge at a stronger hosted model for trustworthy Best-mode choices and evals.
# The judge receives the original text and the rewrites.
# HUMANLY_JUDGE_PROVIDER=groq          # anthropic | groq | openrouter | nvidia | ollama
# HUMANLY_JUDGE_MODEL=llama-3.3-70b-versatile

# ---- Rewrite quality ---------------------------------------------------------------
# compact = short prompt + built-in examples, for small local models (default on Ollama)
# HUMANLY_PROMPT_PROFILE=compact
# Context window to budget prompts against (Ollama default 4096). If you start
# Ollama with OLLAMA_CONTEXT_LENGTH=8192, set this to 8192 too.
# HUMANLY_NUM_CTX=4096
# Retry once when a draft barely changed the wording (0 = off)
# HUMANLY_NEAR_COPY_RETRIES=1
# OpenAI-compatible providers only (never sent to Anthropic):
# HUMANLY_DRAFT_TEMPERATURE=        # unset = provider default
# HUMANLY_SEED=1                    # fixed seed for reproducible evals
# HUMANLY_THINK=off                 # Ollama: keep reasoning models from "thinking"
# HUMANLY_KEEP_ALIVE=30m            # Ollama: keep the model loaded between requests
# HUMANLY_SAMPLING=off              # send none of the above

# Competing drafts per "Best" rewrite (1-5). Default 3 on Anthropic, 2 on hosted free
# providers, 1 on Ollama (parallel requests slow a local model down).
# HUMANLY_DEFAULT_QUALITY=fast   # quality preselected in the UI (fast on Ollama, best otherwise)
# HUMANLY_CANDIDATES=2
# Minimum gap between provider calls in ms, to stay under free per-minute caps.
# HUMANLY_MIN_INTERVAL_MS=1600

# ---- Limits (0 = off) --------------------------------------------------------
# HUMANLY_MAX_WORDS=0
# HUMANLY_RATE_LIMIT_PER_MIN=0

# ---- Learning ----------------------------------------------------------------
# HUMANLY_DATA_DIR=./data
# HUMANLY_AUTO_LEARN_EVERY=10
# HUMANLY_LEARN_TOLERANCE=0.15
