# Required: your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Models. All default to claude-haiku-5-5. For the highest quality, try
# HUMANLY_BEST_MODEL=claude-opus-5-5 (or claude-fable-5-1) and a judge model
# that differs from the drafting model.
# HUMANLY_FAST_MODEL=claude-haiku-5-5
# HUMANLY_BEST_MODEL=claude-haiku-5-5
# HUMANLY_JUDGE_MODEL=claude-haiku-5-5
# HUMANLY_FAST_EFFORT=low
# HUMANLY_BEST_EFFORT=medium
# HUMANLY_JUDGE_EFFORT=medium

# Competing drafts per "Best" rewrite (1-5)
# HUMANLY_CANDIDATES=3

# Limits (0 = off)
# HUMANLY_MAX_WORDS=0
# HUMANLY_RATE_LIMIT_PER_MIN=0

# Learning
# HUMANLY_DATA_DIR=./data
# HUMANLY_AUTO_LEARN_EVERY=10
# HUMANLY_LEARN_TOLERANCE=0.15
