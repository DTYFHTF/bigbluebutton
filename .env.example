# ---- Choose a provider -------------------------------------------------------
# anthropic (default) | nvidia | openrouter | groq | custom
HUMANLY_PROVIDER=anthropic

# Anthropic (paid, best quality): https://console.anthropic.com
ANTHROPIC_API_KEY=

# Free options (OpenAI-compatible). Set HUMANLY_PROVIDER to match.
#   nvidia:      key from https://build.nvidia.com  (starts with nvapi-)
#   openrouter:  key from https://openrouter.ai/keys
#   groq:        key from https://console.groq.com/keys
# NVIDIA_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# custom provider: HUMANLY_BASE_URL=https://.../v1 and HUMANLY_API_KEY=

# ---- Models ------------------------------------------------------------------
# Defaults: claude-haiku-5-5 on Anthropic; meta/llama-3.3-70b-instruct on NVIDIA;
# meta-llama/llama-3.3-70b-instruct:free on OpenRouter; llama-3.3-70b-versatile
# on Groq. Free catalogues change, so override if a default is retired.
# HUMANLY_FAST_MODEL=
# HUMANLY_BEST_MODEL=
# HUMANLY_JUDGE_MODEL=
# HUMANLY_FAST_EFFORT=low      # Anthropic only
# HUMANLY_BEST_EFFORT=medium   # Anthropic only
# HUMANLY_JUDGE_EFFORT=medium  # Anthropic only

# Competing drafts per "Best" rewrite (1-5). Default 3 on Anthropic, 2 on free providers.
# HUMANLY_CANDIDATES=2
# Minimum gap between provider calls in ms, to stay under free per-minute caps.
# HUMANLY_MIN_INTERVAL_MS=1600

# ---- Limits (0 = off) --------------------------------------------------------
# HUMANLY_MAX_WORDS=0
# HUMANLY_RATE_LIMIT_PER_MIN=0

# ---- Learning ----------------------------------------------------------------
# HUMANLY_DATA_DIR=./data
# HUMANLY_AUTO_LEARN_EVERY=10
# HUMANLY_LEARN_TOLERANCE=0.15
